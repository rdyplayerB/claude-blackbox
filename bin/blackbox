#!/usr/bin/env python3
"""blackbox — flight recorder + rescue for Claude Code sessions.

Claude Code already records every session to a transcript and can rebuild a
session from it (`claude --resume`). What it does not do is notice death: a
session killed by a crash, a quit, or a closed terminal looks identical on disk
to one that ended cleanly, and if the session ran under a non-default
CLAUDE_CONFIG_DIR its transcript is not even in the place `--resume` looks by
default. blackbox closes exactly that gap — a marker per live session, removed
on clean exit, so anything left behind is a crash with a known cwd, config dir,
and resume command.

Wired in as three hooks (see install.sh):
  SessionStart -> blackbox hook start   register marker; warn if not recording
  Stop         -> blackbox hook stop    heartbeat: stamp last completed turn
  SessionEnd   -> blackbox hook end     clean exit: remove marker

Commands:
  blackbox                 the Black Box Picker: type to filter, Enter resumes
  blackbox list [--json]   crashed sessions (marker present, pid dead)
  blackbox rescue [id]     picker, or resume a session id directly
  blackbox scan            registry-free sweep of every known storage root
  blackbox doctor          is the recorder recording? hooks, errors, coverage
"""

import json
import os
import shlex
import sys
import time
import subprocess

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".blackbox")
LIVE = os.path.join(STATE, "live")
ROOTS = os.path.join(STATE, "roots.json")
LOG = os.path.join(STATE, "log.jsonl")
LOG_MAX_BYTES = 5_000_000
LOG_KEEP_LINES = 2000

# Session-identity markers inherited from a parent Claude session. Any of these
# means this session believes it is a child and has switched transcript saving
# OFF — the one state blackbox cannot rescue, only shout about. (A real machine
# lost four day-long conversations to exactly this on 2026-08-06.)
SAVING_OFF_VARS = ["CLAUDE_CODE_CHILD_SESSION"]


# --- logging -----------------------------------------------------------------
# The hooks deliberately swallow every exception — a broken recorder must never
# break the session it records. Swallowing without logging, though, makes
# failure invisible: nothing anywhere would say the recorder was broken until
# the day a rescue comes up empty. So: swallow, but write everything to a local
# JSONL first. `blackbox doctor` is the reader.

def _flock_bounded(fcntl, f, op, tries=20, delay=0.05):
    """Non-blocking lock with a ~1s retry budget. A blocking flock made every
    hook on the machine wait behind one stuck lock-holder (measured: 19.5s,
    i.e. until the hook timeout). A session must never stall on telemetry:
    if the lock stays busy, the caller drops the work instead."""
    for _ in range(tries):
        try:
            fcntl.flock(f, op | fcntl.LOCK_NB)
            return True
        except OSError:
            time.sleep(delay)
    return False


def _log(event, **kw):
    """Append one JSONL line, safely under concurrency. Several sessions log
    at once; a naive read-tail-rewrite truncation clobbers concurrent appends
    (measured: ~6% of lines lost at the boundary). Appenders take a shared
    flock and re-verify the path still names their inode — an appender that
    lost a race against truncation's os.replace() reopens instead of writing
    into the orphaned file. The truncator takes the exclusive flock, so it
    only ever rewrites a quiescent log."""
    try:
        import fcntl
        os.makedirs(STATE, exist_ok=True)
        kw["ts"] = round(time.time(), 3)
        kw["event"] = event
        line = json.dumps(kw) + "\n"
        for _ in range(3):
            with open(LOG, "a") as f:
                if not _flock_bounded(fcntl, f, fcntl.LOCK_SH):
                    return  # lock stuck — drop the line, never the session
                try:
                    if os.fstat(f.fileno()).st_ino != os.stat(LOG).st_ino:
                        continue  # replaced under us — reopen and retry
                    f.write(line)
                    break
                finally:
                    fcntl.flock(f, fcntl.LOCK_UN)
        try:
            if os.path.getsize(LOG) > LOG_MAX_BYTES:
                _truncate_log(fcntl)
        except OSError:
            pass
    except Exception:
        pass  # logging must never become its own failure mode


def _truncate_log(fcntl):
    """Rewrite the log to its last LOG_KEEP_LINES under an exclusive flock.
    The lock waits out in-flight appends, and appends that begin after the
    os.replace() land in the new file via the inode re-check in _log."""
    with open(LOG, "a") as f:
        if not _flock_bounded(fcntl, f, fcntl.LOCK_EX, tries=5):
            return  # busy — the next log call will retry truncation
        try:
            if os.fstat(f.fileno()).st_ino != os.stat(LOG).st_ino:
                return  # someone else already truncated
            if os.path.getsize(LOG) <= LOG_MAX_BYTES:
                return
            tail = open(LOG, errors="ignore").readlines()[-LOG_KEEP_LINES:]
            tmp = LOG + ".tmp"
            with open(tmp, "w") as t:
                t.writelines(tail)
            os.replace(tmp, LOG)
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def _log_tail(n=5000):
    try:
        out = []
        for line in open(LOG, errors="ignore").readlines()[-n:]:
            try:
                out.append(json.loads(line))
            except Exception:
                continue
        return out
    except OSError:
        return []


# --- tiny utils --------------------------------------------------------------

def _read_stdin_json():
    try:
        return json.load(sys.stdin)
    except Exception:
        return {}


def _config_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))


def _alive(pid, started_at=None):
    """Is this pid our still-running session? Existence alone is not enough:
    pids are recycled (guaranteed after a reboot), and a stranger wearing the
    dead session's pid would hide the crash forever. So when the marker's
    started_at is known, a process that began *after* it is somebody else."""
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except (OSError, ValueError):
        return False
    if not started_at:
        return True
    try:
        # etime is locale-stable: [[dd-]hh:]mm:ss elapsed since process start.
        out = subprocess.run(["ps", "-p", str(int(pid)), "-o", "etime="],
                             capture_output=True, text=True, timeout=2)
        et = out.stdout.strip()
        if out.returncode != 0 or not et:
            return False
        days, rest = (et.split("-") + [""])[:2] if "-" in et else ("0", et)
        parts = [int(x) for x in rest.split(":")]
        while len(parts) < 3:
            parts.insert(0, 0)
        elapsed = int(days) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]
        # 120s of slack: SessionStart fires moments after the process starts,
        # and etime is rounded to whole seconds.
        return time.time() - elapsed <= started_at + 120
    except Exception:
        return True  # can't verify — assume alive rather than false-crash it


def _session_pid():
    """The pid of the claude process this hook serves. A manual install's
    simple hook command gets exec-optimized by the dispatching shell, so
    getppid() IS claude — but a plugin install runs the binary inside a
    compound bash -c command, which forks: getppid() is a transient wrapper
    shell that dies seconds later, and a marker recording it would make every
    live session read as crashed. Walk ancestors past shells to the process
    whose death actually means the session died."""
    pid = os.getppid()
    try:
        for _ in range(5):
            out = subprocess.run(["ps", "-p", str(pid), "-o", "ppid=,comm="],
                                 capture_output=True, text=True, timeout=2)
            fields = out.stdout.split()
            if out.returncode != 0 or len(fields) < 2:
                break
            comm = os.path.basename(fields[1]).lstrip("-")
            if comm not in ("bash", "sh", "zsh", "dash", "ksh", "fish"):
                break
            pid = int(fields[0])
    except Exception:
        pass
    return pid


def _write_marker(path, mark):
    """Atomic: a crash mid-write must not leave a half-written marker, because
    a corrupt marker is an invisible session — the exact failure this tool
    exists to prevent."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(mark, f)
    os.replace(tmp, path)


# --- auto-wiring -------------------------------------------------------------
# One install must cover the whole machine, including CLAUDE_CONFIG_DIR
# profiles that do not exist yet. Installation is machine-shared but
# enablement is per-root settings, and a five-hour unprotected hole (a
# session crashed in it markerless) proved that "install once per root" is a
# promise users cannot keep. So every session start discovers sibling roots
# from the environments of running claude processes and wires any root that
# was never wired before. Explicit intent is respected: an uninstall writes
# an opt-out flag, and a root is auto-wired at most once ever — disable it
# afterward and it stays disabled.

AUTOWIRED = os.path.join(STATE, "autowired.json")
NO_AUTOWIRE = os.path.join(STATE, "no-autowire")


def _root_wiring(root):
    """(manual, plugin) wiring signals from the root's own settings.json —
    the only file that decides protection. BOTH true means every hook fires
    twice, a state the README warns about and doctor must catch."""
    manual = plugin = False
    try:
        s = json.load(open(os.path.join(root, "settings.json"),
                           encoding="utf-8-sig"))
    except Exception:
        return False, False
    for entries in s.get("hooks", {}).values():
        for entry in entries if isinstance(entries, list) else []:
            for h in entry.get("hooks", []):
                if '/bin/blackbox" hook' in h.get("command", ""):
                    manual = True
    ep = s.get("enabledPlugins", {})
    plugin = isinstance(ep, dict) and any(
        "blackbox@" in k and bool(v) for k, v in ep.items())
    return manual, plugin


def _root_wired(root):
    manual, plugin = _root_wiring(root)
    return manual or plugin


def _discover_roots():
    """CLAUDE_CONFIG_DIR of every running claude process, via `ps eww` (env
    is visible for same-user processes on macOS and most Linuxes). Any
    profile that runs a session while any protected session lives gets
    discovered — no configuration, no tool-specific paths."""
    import re
    found = set()
    try:
        out = subprocess.run(["ps", "ewwax", "-o", "command="],
                             capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            if "claude" not in line:
                continue
            m = re.search(r"CLAUDE_CONFIG_DIR=(\S+)", line)
            if m and os.path.isdir(m.group(1)):
                found.add(os.path.realpath(m.group(1)))
    except Exception:
        pass
    return found


def _plugin_installed_anywhere():
    """Does any root's registry know the blackbox plugin? (The registry is
    machine-shared in practice; checking every known root covers the rest.)"""
    for root in [os.path.join(HOME, ".claude")] + list(_all_roots()):
        try:
            if "blackbox@" in open(
                    os.path.join(root, "plugins", "installed_plugins.json"),
                    errors="ignore").read():
                return True
        except OSError:
            continue
    return False


def _wire_root(root):
    """Wire one root through its settings.json, atomically and backed up.
    Prefer plugin enablement (updates keep flowing through the marketplace);
    fall back to manual hook commands pointing at this binary."""
    sp = os.path.join(root, "settings.json")
    sp_real = os.path.realpath(sp) if os.path.exists(sp) else sp
    try:
        s = json.load(open(sp_real, encoding="utf-8-sig")) if os.path.exists(sp_real) else {}
    except ValueError:
        return False  # never auto-edit a file we cannot parse
    if os.path.exists(sp_real):
        try:
            import shutil
            shutil.copy2(sp_real, sp_real + ".bak-blackbox-autowire")
        except OSError:
            return False
    if _plugin_installed_anywhere():
        s.setdefault("enabledPlugins", {})["blackbox@rdyplayerB"] = True
        mode = "plugin"
    else:
        me = os.path.realpath(os.path.abspath(sys.argv[0]))
        hooks = s.setdefault("hooks", {})
        for event, sub in (("SessionStart", "start"), ("Stop", "stop"),
                           ("SessionEnd", "end")):
            entries = hooks.setdefault(event, [])
            if any('/bin/blackbox" hook' in h.get("command", "")
                   for e in entries for h in e.get("hooks", [])):
                continue
            entries.append({"hooks": [{"type": "command",
                                       "command": f'"{me}" hook {sub}'}]})
        mode = "manual"
    tmp = sp_real + ".blackbox-tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=2)
    json.load(open(tmp))
    os.replace(tmp, sp_real)
    _log("autowire", root=root.replace(HOME, "~"), mode=mode)
    return True


def _autowire():
    """Called at session start. Discover sibling roots, wire any that were
    never wired — at most once per root, never after an opt-out."""
    try:
        if os.path.exists(NO_AUTOWIRE):
            return
        done = {}
        try:
            loaded = json.load(open(AUTOWIRED))
            if isinstance(loaded, dict):
                done = loaded
        except Exception:
            pass
        candidates = _discover_roots()
        candidates.update(os.path.realpath(r) for r in _all_roots())
        changed = False
        for root in candidates:
            if root in done:
                continue
            if _root_wired(root):
                # Seen wired once: if the user later unwires it, that choice
                # sticks — we never re-wire a root behind their back.
                done[root] = time.time()
                changed = True
                continue
            _remember_root(root)
            try:
                if _wire_root(root):
                    done[root] = time.time()
                    changed = True
            except Exception:
                import traceback
                _log("autowire", root=root.replace(HOME, "~"), ok=False,
                     err=traceback.format_exc()[-800:])
        if changed:
            tmp = AUTOWIRED + ".tmp"
            json.dump(done, open(tmp, "w"))
            os.replace(tmp, AUTOWIRED)
    except Exception:
        pass  # wiring convenience must never break a session


def _git_branch(cwd):
    try:
        out = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, timeout=2,
        )
        return out.stdout.strip() if out.returncode == 0 else ""
    except Exception:
        return ""


def _remember_root(root):
    """Track every CLAUDE_CONFIG_DIR ever seen, so scan/list can search them all."""
    roots = []
    try:
        loaded = json.load(open(ROOTS))
        if isinstance(loaded, list):
            roots = [r for r in loaded if isinstance(r, str)]
    except Exception:
        pass
    if root not in roots:
        roots.append(root)
        try:
            os.makedirs(STATE, exist_ok=True)
            json.dump(roots, open(ROOTS, "w"))
        except Exception:
            pass
    return roots


def _all_roots():
    roots = [os.path.join(HOME, ".claude")]
    try:
        loaded = json.load(open(ROOTS))
        for r in (loaded if isinstance(loaded, list) else []):
            if isinstance(r, str) and r not in roots:
                roots.append(r)
    except Exception:
        pass
    return [r for r in roots if os.path.isdir(os.path.join(r, "projects"))] or roots


def _preview(transcript_path, tail_bytes=2_000_000):
    """Last human prompt and last assistant text from a transcript.

    Wrapper records (command output, system reminders, observation wrappers) all
    open with '<'; a person's prompt almost never does. Falls back to a
    full-file scan when the tail is all tool traffic.
    """
    def scan(data):
        u = a = ""
        for line in data.split("\n"):
            if not line.strip():
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("isMeta"):
                continue
            m = d.get("message") or {}
            c = m.get("content")
            texts = []
            if isinstance(c, str):
                texts = [c]
            elif isinstance(c, list):
                texts = [b.get("text", "") for b in c
                         if isinstance(b, dict) and b.get("type") == "text"]
            for txt in texts:
                t = txt.strip()
                if not t or t.startswith("<") or t.startswith("Caveat:"):
                    continue
                if d.get("type") == "user":
                    u = t
                elif d.get("type") == "assistant":
                    a = t
        return u, a

    try:
        size = os.path.getsize(transcript_path)
        with open(transcript_path, "rb") as f:
            f.seek(max(0, size - tail_bytes))
            u, a = scan(f.read().decode("utf-8", "ignore"))
        if not (u or a) and size > tail_bytes:
            u, a = scan(open(transcript_path, encoding="utf-8", errors="ignore").read())
        return u.replace("\n", " ")[:160], a.replace("\n", " ")[:160]
    except Exception:
        return "", ""


def _classify(transcript_path):
    """'ok' — real conversation records; 'skeleton' — sidecar metadata only;
    'missing' — no file.

    A session with transcript saving disabled still writes a file — but it holds
    only last-prompt stubs, ai-title, mode records. Resuming it restores an
    almost-empty conversation, so offering `--resume` for one is a false
    promise; it gets salvage instead.
    """
    if not transcript_path or not os.path.exists(transcript_path):
        return "missing"
    meta_only = False
    try:
        with open(transcript_path, errors="ignore") as f:
            for line in f:
                if '"type":"user"' in line or '"type":"assistant"' in line:
                    return "ok"
                if '"type":"last-prompt"' in line or '"type":"ai-title"' in line:
                    meta_only = True
    except Exception:
        pass
    # A file with neither messages nor metadata has nothing to offer either way.
    return "skeleton" if meta_only else "missing"


def _salvage(transcript_path):
    """Extract whatever a skeleton still holds: the title and the ordered
    prompt stubs (~200 chars each). Not the conversation — its outline; enough
    to re-seed a new session with what was being worked on."""
    title = ""
    prompts = []
    try:
        with open(transcript_path, errors="ignore") as f:
            for line in f:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("type") == "ai-title":
                    title = d.get("aiTitle", title)
                elif d.get("type") == "last-prompt":
                    # Collapse internal newlines (a multi-line prompt would
                    # break the numbered outline) and enforce the ~200-char
                    # stub the output header promises — records are usually
                    # that short already, but nothing guarantees it.
                    p = " ".join(d.get("lastPrompt", "").split())[:200]
                    # Teammate/system relays are machinery, not the person's prompts.
                    if p.startswith("Another Claude session sent"):
                        continue
                    if p and (not prompts or prompts[-1] != p):
                        prompts.append(p)
    except Exception:
        pass
    return title, prompts


def cmd_salvage(target):
    # Accept a path or a bare session id searched across every known root.
    path = target if os.path.exists(target) else None
    if not path:
        for root in _all_roots():
            pdir = os.path.join(root, "projects")
            if not os.path.isdir(pdir):
                continue
            for proj in os.listdir(pdir):
                p = os.path.join(pdir, proj, target + ".jsonl")
                if os.path.exists(p):
                    path = p
                    break
            if path:
                break
    if not path:
        print(f"blackbox: no transcript found for {target!r}")
        return
    title, prompts = _salvage(path)
    if not (title or prompts):
        print("blackbox: nothing salvageable in that transcript.")
        return
    os.makedirs(os.path.join(STATE, "salvage"), exist_ok=True)
    sid = os.path.basename(path)[:-6]
    out = os.path.join(STATE, "salvage", sid + ".md")
    with open(out, "w") as f:
        f.write(f"# Salvage: {title or sid}\n\n")
        f.write("The conversation itself was never saved (transcript saving was off).\n")
        f.write("These are the prompts that drove it, in order, truncated at ~200\n")
        f.write("chars each — the outline of the work, for re-seeding a new session.\n\n")
        for i, p in enumerate(prompts, 1):
            f.write(f"{i}. {p}\n\n")
    _log("salvage", sid=sid[:8], prompts=len(prompts), titled=bool(title))
    print(f"salvaged {len(prompts)} prompt(s)" + (f' · title: "{title}"' if title else ""))
    print(out)


def _fmt_age(sec):
    sec = int(max(0, sec))
    if sec < 3600:
        return f"{sec // 60}m ago"
    if sec < 86400:
        return f"{sec // 3600}h {sec % 3600 // 60}m ago"
    return f"{sec // 86400}d {sec % 86400 // 3600}h ago"


def _resume_cmd(mark):
    """The exact incantation that brings this session back. shlex-quoted, so a
    path with spaces, quotes, or $ survives the copy-paste. The config root is
    ALWAYS stated, even when it is the default: the shell this gets pasted
    into may have inherited some other profile's CLAUDE_CONFIG_DIR, and an
    implicit root then resumes against the wrong storage."""
    parts = []
    cd = mark.get("config_dir", "")
    if cd:
        parts.append(f"CLAUDE_CONFIG_DIR={shlex.quote(cd)}")
    parts += ["claude", "--resume", shlex.quote(mark["session_id"])]
    return f"cd {shlex.quote(mark.get('cwd', '.'))} && " + " ".join(parts)


# --- hooks -------------------------------------------------------------------

def hook_start():
    d = _read_stdin_json()
    sid = d.get("session_id", "")
    if not sid:
        return
    os.makedirs(LIVE, exist_ok=True)
    # Sweep rescue leftovers: this session's own consumed marker (a rescue
    # that just succeeded re-registers here), plus any .rescued old enough
    # that its rescue clearly wasn't rolled back.
    try:
        for f in os.listdir(LIVE):
            if f.endswith(".rescued"):
                p = os.path.join(LIVE, f)
                if f.startswith(sid) or time.time() - os.path.getmtime(p) > 7 * 86400:
                    os.unlink(p)
    except OSError:
        pass
    cwd = d.get("cwd") or os.getcwd()
    cfg = _config_dir()
    _remember_root(cfg)
    # One install covers the machine: discover sibling profiles and wire any
    # root never wired before (see the auto-wiring section for the rules).
    _autowire()
    mark = {
        "session_id": sid,
        "cwd": cwd,
        "branch": _git_branch(cwd),
        # The hook runs as a child of the claude process itself.
        "pid": _session_pid(),
        "transcript_path": d.get("transcript_path", ""),
        "config_dir": cfg,
        "started_at": time.time(),
        "last_turn": time.time(),
    }
    _write_marker(os.path.join(LIVE, sid + ".json"), mark)
    _log("register", sid=sid[:8], cwd=cwd, has_transcript_path=bool(d.get("transcript_path")))

    # The guard. Saving-off is the ONE unrecoverable state, so it must not pass
    # silently — but the env marker alone is NOT proof: a headless child can
    # carry CLAUDE_CODE_CHILD_SESSION and still save fine (verified 2026-08-07).
    # So: loud only on the definite signal (no transcript path at all); a
    # one-line note on the ambiguous one. The Stop hook then verifies against
    # the actual file after the first completed turn, which is ground truth.
    marker_vars = [v for v in SAVING_OFF_VARS if os.environ.get(v)]
    if not d.get("transcript_path"):
        _log("guard.loud", sid=sid[:8], reason="no transcript_path")
        print(
            "⚠️ BLACKBOX WARNING — TELL THE USER THIS VERBATIM, BEFORE ANYTHING ELSE:\n"
            "This session reported NO transcript path — it is not saving. If it "
            "crashes or is closed, the ENTIRE conversation is unrecoverable. "
            "To fix: exit now and restart claude from a clean shell "
            "(e.g. `env -u CLAUDE_CODE_CHILD_SESSION claude`)."
        )
    elif marker_vars:
        _log("guard.note", sid=sid[:8], vars=marker_vars)
        print(
            f"blackbox: note — {', '.join(marker_vars)} is set, which can disable "
            "transcript saving. Verified against the actual file after your first "
            "turn; a warning follows only if it is really not saving."
        )
    return {"sid": sid[:8]}


def hook_stop():
    d = _read_stdin_json()
    sid = d.get("session_id", "")
    if not sid:
        return
    p = os.path.join(LIVE, sid + ".json")
    # A marker that exists but does not parse is treated as absent so the next
    # block rebuilds it fresh — self-heal, not a permanent per-turn failure.
    existing = None
    if os.path.exists(p):
        try:
            existing = json.load(open(p))
        except Exception:
            _log("marker.corrupt", sid=sid[:8], ok=False)
    # Late registration. Claude Code dispatches hooks from CURRENT settings, so
    # a session that predates install still fires Stop — meaning even sessions
    # blackbox never saw start can be picked up mid-life on their next turn.
    # Without this, "running sessions are unprotected until restarted" ; with
    # it, they join the flight record the first time they finish a turn.
    if existing is None:
        cwd = d.get("cwd") or os.getcwd()
        _remember_root(_config_dir())
        mark = {
            "session_id": sid,
            "cwd": cwd,
            "branch": _git_branch(cwd),
            "pid": _session_pid(),
            "transcript_path": d.get("transcript_path", ""),
            "config_dir": _config_dir(),
            "started_at": time.time(),
            "last_turn": time.time(),
            "registered_late": True,
        }
        try:
            os.makedirs(LIVE, exist_ok=True)
            _write_marker(p, mark)
            _log("register.late", sid=sid[:8], cwd=cwd)
        except Exception:
            # Swallowed (a broken recorder must never break the session), but
            # logged with ok=False so doctor surfaces it as an error.
            import traceback
            _log("register.late", sid=sid[:8], ok=False,
                 err=traceback.format_exc()[-1500:])
        return {"sid": sid[:8], "late": True}
    try:
        mark = existing
        mark["last_turn"] = time.time()
        if d.get("transcript_path"):
            mark["transcript_path"] = d["transcript_path"]
        # Refresh cwd and branch too: a project directory renamed mid-session
        # (observed in the wild) would otherwise leave the resume command
        # pointing at a path that no longer exists.
        if d.get("cwd") and d["cwd"] != mark.get("cwd"):
            mark["cwd"] = d["cwd"]
            mark["branch"] = _git_branch(d["cwd"])
        # Heal the pid: markers written by pre-1.0.2 plugin hooks recorded a
        # transient wrapper shell (observed in the wild as live sessions
        # listed crashed). This hook only fires because the session is alive
        # RIGHT NOW, so re-derive the pid rather than trusting history.
        cur = _session_pid()
        if cur and mark.get("pid") != cur:
            _log("pid.heal", sid=sid[:8], old=mark.get("pid"), new=cur)
            mark["pid"] = cur
        # Ground truth: after a completed turn, a saving session's transcript
        # holds real message records. A skeleton or missing file here means the
        # session is burning unrecoverable context RIGHT NOW — flagged so
        # `blackbox list` shows it while there is still time to act.
        kind = _classify(mark.get("transcript_path", ""))
        if kind != "ok":
            if not mark.get("hazard"):
                _log("hazard.set", sid=sid[:8], kind=kind)
            mark["hazard"] = "not saving — a completed turn produced no conversation records"
        else:
            if mark.get("hazard"):
                _log("hazard.cleared", sid=sid[:8])
            mark.pop("hazard", None)
        _write_marker(p, mark)
        # Per-turn ground truth on the hook.stop log line: the saving verdict
        # and transcript size for every completed turn, not just transitions.
        tbytes = 0
        try:
            tbytes = os.path.getsize(mark.get("transcript_path", ""))
        except OSError:
            pass
        return {"sid": sid[:8], "kind": kind, "tbytes": tbytes}
    except Exception:
        # Swallowed, but logged with ok=False so doctor surfaces it: this is
        # the path that verifies saving, the last place a failure may hide.
        import traceback
        _log("stop.update", sid=sid[:8], ok=False,
             err=traceback.format_exc()[-1500:])


def hook_end():
    d = _read_stdin_json()
    sid = d.get("session_id", "")
    if not sid:
        return
    try:
        os.unlink(os.path.join(LIVE, sid + ".json"))
        _log("clean_exit", sid=sid[:8])
    except OSError:
        # No marker to remove: either start never fired (a coverage gap doctor
        # should surface) or this session was already rescued.
        _log("clean_exit", sid=sid[:8], marker_found=False)
    return {"sid": sid[:8]}


# --- queries -----------------------------------------------------------------

# Directories whose sessions are spawned by tools, not typed by people.
# claude-mem runs its observers from ~/.claude-mem/observer-sessions.
MACHINERY_DIRS = {".claude-mem"}


def _is_machinery(cwd):
    """Sessions run by tools, not people. Memory plugins (claude-mem) and
    similar machinery spawn their own Claude sessions; when a tool kills its
    workers uncleanly they would flood the rescue list with sessions no human
    was ever in. Matched by a DENYLIST of known tool dirs — "any hidden
    directory" was tried first and hid real human work in ~/.dotfiles and
    ~/.config from the rescue flow."""
    try:
        if not cwd:
            return False
        rel = os.path.relpath(cwd, HOME)
        if rel == "." or rel.startswith(".."):
            return False
        if rel.split(os.sep)[0] in MACHINERY_DIRS:
            return True
        return "observer-sessions" in cwd
    except Exception:
        return False


def _claude_cwds_unaccounted(alive_marker_pids):
    """cwd -> count of running claude CLI processes NOT owned by any alive
    marker. A dead-pid marker whose cwd hosts such a process is very likely
    that process wearing a stale (wrapper-pid) marker — a live session that
    would collide if resumed. Observed in the wild: two idle Blogogi sessions
    listed as cleanly rescuable while three claudes ran in that directory."""
    cwds = {}
    try:
        out = subprocess.run(["ps", "ax", "-o", "pid=,comm="],
                             capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            parts = line.split(None, 1)
            if len(parts) != 2 or os.path.basename(parts[1].strip()) != "claude":
                continue
            pid = int(parts[0])
            if pid in alive_marker_pids:
                continue
            lo = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                                capture_output=True, text=True, timeout=3).stdout
            for l in lo.splitlines():
                if l.startswith("n"):
                    cwds[l[1:]] = cwds.get(l[1:], 0) + 1
    except Exception:
        pass
    return cwds


def crashed_sessions():
    out = []
    if not os.path.isdir(LIVE):
        return out
    dead = []
    alive_pids = set()
    for f in os.listdir(LIVE):
        if not f.endswith(".json"):
            continue
        try:
            mark = json.load(open(os.path.join(LIVE, f)))
        except Exception:
            continue
        if _alive(mark.get("pid"), mark.get("started_at")):
            alive_pids.add(int(mark.get("pid", 0)))
            continue
        dead.append(mark)
    orphan_cwds = _claude_cwds_unaccounted(alive_pids) if dead else {}
    for mark in dead:
        tp = mark.get("transcript_path", "")
        kind = _classify(tp)
        if kind != "ok":
            # Died without a real transcript — the guard's case. Reported, not
            # hidden: silently dropping it would repeat the original disaster.
            mark["unrecoverable"] = True
            if kind == "skeleton":
                mark["salvageable"] = True
        mark["machinery"] = _is_machinery(mark.get("cwd", ""))
        u, a = _preview(tp) if kind == "ok" else ("", "")
        mark["last_user"] = u
        mark["last_assistant"] = a
        if kind == "ok":
            mark["resume"] = _resume_cmd(mark)
        # Contradictory evidence that the session is actually still running:
        # a transcript written moments ago, or an unaccounted-for live claude
        # process in the same directory (a stale wrapper-pid marker's real
        # process). Flag rather than hide — hiding would delay a real rescue,
        # but resuming a live session collides with it.
        try:
            if time.time() - _last_activity(tp) < 300:
                mark["maybe_live"] = True
        except OSError:
            pass
        if orphan_cwds.get(mark.get("cwd", ""), 0) > 0:
            mark["maybe_live"] = True
        out.append(mark)
    out.sort(key=lambda m: -m.get("last_turn", 0))
    return out


def live_at_risk():
    """Sessions that are ALIVE but verifiably not saving — the disaster still
    preventable. Four day-long sessions sat in exactly this state for hours on
    2026-08-06 with nothing surfacing it."""
    out = []
    if not os.path.isdir(LIVE):
        return out
    for f in os.listdir(LIVE):
        if not f.endswith(".json"):
            continue
        try:
            mark = json.load(open(os.path.join(LIVE, f)))
        except Exception:
            continue
        if mark.get("hazard") and _alive(mark.get("pid"), mark.get("started_at")):
            out.append(mark)
    return out


def cmd_list(as_json=False, show_all=False):
    """Print the rescue picture and return the crashed list exactly as
    numbered on screen — cmd_rescue indexes THIS list, so what the user sees
    and what a typed number selects can never diverge."""
    crashed = crashed_sessions()
    machinery = [m for m in crashed if m.get("machinery")]
    if not show_all:
        crashed = [m for m in crashed if not m.get("machinery")]
    risky = live_at_risk()
    # The log's record of what detection saw and offered: without this, a
    # crashed session that never surfaced leaves no trail to debug from.
    _log("list",
         crashed=[m["session_id"][:8] for m in crashed],
         unrecoverable=[m["session_id"][:8] for m in crashed
                        if m.get("unrecoverable")],
         risky=[m["session_id"][:8] for m in risky],
         machinery=len(machinery))
    if as_json:
        # Machinery is data, not a secret: consumers (the /rescue skill) get
        # the hidden entries too and decide for themselves.
        print(json.dumps({"crashed": crashed, "live_at_risk": risky,
                          "machinery_hidden": [] if show_all else machinery},
                         indent=2))
        return crashed
    for m in risky:
        proj = m.get("cwd", "?").replace(HOME, "~")
        print(f"⚠ LIVE BUT NOT SAVING: {proj} — {m['hazard']}")
        print("   Everything typed there is unrecoverable if it dies. Restart that session cleanly.")
    if machinery and not show_all:
        print(f"({len(machinery)} background tool session(s) hidden — plugins running their own claudes; --all shows them)")
    if not crashed:
        print("blackbox: no crashed sessions. (Live ones are fine; clean exits are cleaned up.)")
        return crashed
    now = time.time()
    for i, m in enumerate(crashed, 1):
        proj = m.get("cwd", "?").replace(HOME, "~")
        br = f" ({m['branch']})" if m.get("branch") else ""
        print(f"\n[{i}] {proj}{br} — last active {_fmt_age(now - m.get('last_turn', now))}")
        if m.get("unrecoverable"):
            print("     ✗ UNRECOVERABLE — the conversation was never saved")
            if m.get("salvageable"):
                print(f"     partial: blackbox salvage {m['session_id']}   (title + prompt outline)")
            continue
        if m.get("maybe_live"):
            print("     ⚠ this session may still be RUNNING (fresh transcript writes, or a")
            print("       live claude in its directory that no marker accounts for).")
            print("       Check that its window is really gone before resuming.")
        if m.get("last_user"):
            print(f"     you : {m['last_user']}")
        if m.get("last_assistant"):
            print(f"     it  : {m['last_assistant']}")
        print(f"     resume: {m['resume']}")
    return crashed


def _exec_resume(m):
    """Become the resumed session: consume any marker (reversibly), set the
    right config root, cd to the project, exec claude."""
    sid = m["session_id"]
    # The exec below replaces this process, so this line is the only record of
    # exactly what was launched.
    _log("rescue", sid=sid[:8], cwd=m.get("cwd", ""),
         resume=m.get("resume", ""), config_dir=m.get("config_dir", ""))
    # Consume the marker by RENAME, not unlink: if the exec below fails, the
    # rename is reversed and the crash record survives. Deleting first would
    # silently erase the one pointer to the crashed session — the exact loss
    # this tool exists to prevent. On success the resumed session registers
    # a fresh marker and the .rescued file is swept by the next hook start.
    mp = os.path.join(LIVE, sid + ".json")
    consumed = mp + ".rescued"
    had_marker = os.path.exists(mp)
    if had_marker:
        try:
            os.replace(mp, consumed)
        except OSError:
            _log("rescue.consume", sid=sid[:8], ok=False)
    env = dict(os.environ)
    cd = m.get("config_dir", "")
    # Set the session's root EXPLICITLY, even when it is the default: this
    # shell may have inherited some other profile's CLAUDE_CONFIG_DIR, and
    # resuming against the wrong root fails with "no conversation found".
    if cd:
        env["CLAUDE_CONFIG_DIR"] = cd
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)
    try:
        os.chdir(m.get("cwd", "."))
    except OSError:
        # The project directory is gone (deleted or on an unmounted volume).
        # The transcript lives under the config root, so the resume still
        # works — just not from the original cwd.
        print(f"blackbox: original cwd {m.get('cwd', '?')!r} no longer exists; "
              "resuming from ~ instead.")
        os.chdir(HOME)
    # Replace this process with the resumed session — the terminal becomes claude.
    try:
        os.execvpe("claude", ["claude", "--resume", sid], env)
    except OSError:
        if had_marker:
            try:
                os.replace(consumed, mp)  # restore the crash record
            except OSError:
                pass
        _log("rescue.exec", sid=sid[:8], ok=False)
        print("blackbox: could not exec `claude` (not on PATH?). Run this by hand:")
        print(f"  {m.get('resume', '')}")


def _last_activity(tp):
    """When the CONVERSATION last moved, not when the file did. Claude Code
    appends metadata stubs (last-prompt, ai-title, system records) to
    transcripts of closed sessions, so mtime routinely lies — measured 4% of
    recent transcripts with mtime 10+ minutes fresher than their last real
    exchange, one by 7.75 hours. Reads the tail; falls back to mtime."""
    import datetime
    try:
        size = os.path.getsize(tp)
        with open(tp, "rb") as f:
            f.seek(max(0, size - 200_000))
            data = f.read().decode("utf-8", "ignore")
        best = None
        for line in data.split("\n"):
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("type") in ("user", "assistant") and d.get("timestamp"):
                best = d["timestamp"]
        if best:
            return datetime.datetime.fromisoformat(
                best.replace("Z", "+00:00")).timestamp()
        return os.path.getmtime(tp)
    except Exception:
        try:
            return os.path.getmtime(tp)
        except OSError:
            return 0


def _cwd_from_transcript(tp):
    """Transcript records carry the session's real cwd."""
    try:
        with open(tp, errors="ignore") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("cwd"):
                    return d["cwd"]
    except OSError:
        pass
    return HOME


def _session_record(root, tp, sid):
    """A resumable record for a transcript, marker or no marker."""
    m = {"session_id": sid, "cwd": _cwd_from_transcript(tp),
         "config_dir": root, "transcript_path": tp}
    kind = _classify(tp)
    if kind != "ok":
        m["unrecoverable"] = True
        if kind == "skeleton":
            m["salvageable"] = True
    else:
        m["resume"] = _resume_cmd(m)
    return m


def _alive_marker_sids():
    out = set()
    if os.path.isdir(LIVE):
        for f in os.listdir(LIVE):
            if f.endswith(".json"):
                try:
                    mk = json.load(open(os.path.join(LIVE, f)))
                    if _alive(mk.get("pid"), mk.get("started_at")):
                        out.add(mk.get("session_id", ""))
                except Exception:
                    continue
    return out


def _find_session_anywhere(prefix, max_matches=7):
    """Resolve a session-id prefix across crashed markers and every storage
    root — cleanly-closed sessions (no marker: closing a window IS a clean
    exit) are as findable as crashed ones. Returns (records, truncated):
    every distinct match up to the cap, each carrying an `alive` flag when a
    live marker owns that sid. The caller decides what a unique / ambiguous /
    running match means — resolving 'a' to one of 840 sessions silently, or
    execing into a RUNNING session, were both real bugs here."""
    alive = _alive_marker_sids()
    crashed = {m["session_id"]: m for m in crashed_sessions()}
    found = {}
    for sid, m in crashed.items():
        if sid.startswith(prefix):
            found[sid] = m
    for root in _all_roots():
        pdir = os.path.join(root, "projects")
        if not os.path.isdir(pdir):
            continue
        for proj in sorted(os.listdir(pdir)):
            full = os.path.join(pdir, proj)
            if not os.path.isdir(full):
                continue
            for f in sorted(os.listdir(full)):
                if not f.endswith(".jsonl") or not f.startswith(prefix):
                    continue
                sid = f[:-6]
                if sid in found:
                    continue
                if len(found) > max_matches:
                    return list(found.values()), True
                found[sid] = _session_record(root, os.path.join(full, f), sid)
    for sid, m in found.items():
        if sid in alive:
            m["alive"] = True
    return list(found.values()), False


def _recent_sessions(cwd=None, limit=5):
    """The flight-recorder view: the last N resumable sessions, newest first,
    with no expiry — a rolling buffer of whatever happened, each entry aged.
    Scoped to one project when cwd is given, machine-wide otherwise. Live
    sessions are excluded (resuming a running session collides with it);
    machinery is excluded; crashed sessions are included regardless of size,
    everything else needs a substantive transcript."""
    crashed = {m["session_id"]: m for m in crashed_sessions()
               if not m.get("machinery")}
    alive_sids = set()
    if os.path.isdir(LIVE):
        for f in os.listdir(LIVE):
            if f.endswith(".json"):
                try:
                    mk = json.load(open(os.path.join(LIVE, f)))
                    if _alive(mk.get("pid"), mk.get("started_at")):
                        alive_sids.add(mk.get("session_id", ""))
                except Exception:
                    continue
    want = _project_slug(os.path.abspath(cwd)) if cwd else None
    rows = []
    for root in _all_roots():
        pdir = os.path.join(root, "projects")
        if not os.path.isdir(pdir):
            continue
        for proj in os.listdir(pdir):
            if want and proj != want:
                continue
            if "claude-mem-observer" in proj:
                continue  # machinery farms
            full = os.path.join(pdir, proj)
            if not os.path.isdir(full):
                continue
            for f in os.listdir(full):
                if not f.endswith(".jsonl"):
                    continue
                sid = f[:-6]
                if sid in alive_sids:
                    continue
                tp = os.path.join(full, f)
                try:
                    st = os.stat(tp)
                except OSError:
                    continue
                if st.st_size <= 50_000 and sid not in crashed:
                    continue  # tiny and not a known crash: noise
                rows.append((st.st_mtime, root, tp, sid))
    rows.sort(reverse=True)
    alive_pids = set()
    if os.path.isdir(LIVE):
        for f in os.listdir(LIVE):
            if f.endswith(".json"):
                try:
                    mk = json.load(open(os.path.join(LIVE, f)))
                    if mk.get("session_id") in alive_sids:
                        alive_pids.add(int(mk.get("pid", 0)))
                except Exception:
                    continue
    orphans = _claude_cwds_unaccounted(alive_pids) if rows else {}
    out = []
    for mt, root, tp, sid in rows[:limit]:
        if sid in crashed:
            m = dict(crashed[sid])
            m["ended"] = "crashed"
        else:
            m = _session_record(root, tp, sid)
            m["ended"] = "closed cleanly"
            u, a = _preview(tp, tail_bytes=300_000)
            m["last_user"], m["last_assistant"] = u, a
            # A session with no marker can still be RUNNING (it started under
            # an unhooked root). An unaccounted live claude in its directory,
            # or a transcript written moments ago, is the tell.
            act = _last_activity(tp)
            if orphans.get(m.get("cwd", ""), 0) > 0 or time.time() - act < 300:
                m["maybe_live"] = True
            mt = act or mt
        m["age"] = time.time() - mt
        out.append(m)
    return out


def _gather_boxes(cwd=None, cap=400):
    """Cheap candidate rows for the picker: (mtime, root, tp, sid, project),
    newest first, live sessions and machinery excluded. Enrichment (real
    age, gist, ended-how) happens lazily per displayed row — this must stay
    fast with years of history on disk."""
    alive = _alive_marker_sids()
    crashed_sids = set()
    if os.path.isdir(LIVE):
        for f in os.listdir(LIVE):
            if f.endswith(".json"):
                try:
                    mk = json.load(open(os.path.join(LIVE, f)))
                    if mk.get("session_id") not in alive:
                        crashed_sids.add(mk.get("session_id"))
                except Exception:
                    continue
    want = _project_slug(os.path.abspath(cwd)) if cwd else None
    rows = []
    for root in _all_roots():
        pdir = os.path.join(root, "projects")
        if not os.path.isdir(pdir):
            continue
        for proj in os.listdir(pdir):
            if want and proj != want:
                continue
            if "claude-mem-observer" in proj:
                continue
            full = os.path.join(pdir, proj)
            if not os.path.isdir(full):
                continue
            for f in os.listdir(full):
                if not f.endswith(".jsonl"):
                    continue
                sid = f[:-6]
                if sid in alive:
                    continue
                tp = os.path.join(full, f)
                try:
                    st = os.stat(tp)
                except OSError:
                    continue
                if st.st_size <= 50_000 and sid not in crashed_sids:
                    continue
                rows.append((st.st_mtime, root, tp, sid,
                             proj.split("-")[-1] or proj))
    rows.sort(reverse=True)
    return rows[:cap], crashed_sids


def _enrich_box(cache, row, crashed_sids):
    """Fill one picker row's display fields, memoized."""
    mt, root, tp, sid = row[0], row[1], row[2], row[3]
    if sid in cache:
        return cache[sid]
    act = _last_activity(tp)
    u, a = _preview(tp, tail_bytes=64_000)
    e = {"age": time.time() - (act or mt),
         "gist": (u or a or "").replace("\n", " ")[:80],
         "ended": "crashed" if sid in crashed_sids else "closed"}
    cache[sid] = e
    return e


def _picker_ui(stdscr, state):
    """The Black Box Picker: one line per box, type to filter, Enter to
    resume. Filtering replaces scrolling — that is what makes unlimited
    history navigable."""
    import curses
    curses.curs_set(0)
    stdscr.timeout(-1)
    filt = ""
    cursor = 0
    while True:
        rows, crashed_sids, cache, scope = (state["rows"], state["crashed"],
                                            state["cache"], state["scope"])
        h, w = stdscr.getmaxyx()
        vis_cap = max(3, h - 5)
        if filt:
            f = filt.lower()
            matches = []
            for r in rows:
                if f in r[4].lower() or f in r[3][:12].lower():
                    matches.append(r)
                    continue
                e = cache.get(r[3])
                if e and f in e["gist"].lower():
                    matches.append(r)
            # content-match rows not yet enriched, up to a budget
            budget = 200
            for r in rows:
                if r in matches or budget <= 0:
                    continue
                budget -= 1
                e = _enrich_box(cache, r, crashed_sids)
                if f in e["gist"].lower():
                    matches.append(r)
        else:
            matches = list(rows)
        cursor = max(0, min(cursor, len(matches) - 1))
        top = max(0, cursor - vis_cap + 1)
        stdscr.erase()
        title = " BLACK BOXES "
        stdscr.addnstr(0, 0, ("▄▄▄" + title + "▄" * w)[:w - 1], w - 1)
        scope_tag = "[Tab: everywhere]" if scope == "here" else "[Tab: this project]"
        stdscr.addnstr(1, 1, f"filter: {filt}_", w - 22)
        stdscr.addnstr(1, max(0, w - len(scope_tag) - 2), scope_tag, len(scope_tag))
        for i, r in enumerate(matches[top:top + vis_cap]):
            e = _enrich_box(cache, r, crashed_sids)
            line = (f"{_fmt_age(e['age']):>10}  {r[4][:18]:18} "
                    f"{e['ended']:7} {e['gist']}")
            attr = curses.A_REVERSE if top + i == cursor else curses.A_NORMAL
            marker = "▸ " if top + i == cursor else "  "
            stdscr.addnstr(2 + i, 0, (marker + line), w - 1, attr)
        foot = (f" {len(matches)} of {len(rows)} boxes · Enter resume · "
                "Esc clear/quit · Tab scope ")
        stdscr.addnstr(min(h - 2, 2 + vis_cap), 0, foot[:w - 1], w - 1)
        stdscr.addnstr(min(h - 1, 3 + vis_cap), 0, ("▀" * w)[:w - 1], w - 1)
        stdscr.refresh()
        ch = stdscr.getch()
        if ch in (curses.KEY_UP,):
            cursor -= 1
        elif ch in (curses.KEY_DOWN,):
            cursor += 1
        elif ch == 27:
            # A bare ESC quits/clears — but arrow keys ARRIVE as ESC [ A/B
            # when keypad translation is unavailable, and treating their lead
            # byte as Esc made the first arrow press exit the picker (found
            # by driving the UI through a pty). Peek: sequence bytes present
            # means a key, silence means the user really pressed Esc.
            stdscr.nodelay(True)
            nxt = stdscr.getch()
            if nxt in (91, 79):  # '[' or 'O'
                fin = stdscr.getch()
                stdscr.nodelay(False)
                if fin == 65:
                    cursor -= 1
                elif fin == 66:
                    cursor += 1
            else:
                stdscr.nodelay(False)
                if filt:
                    filt = ""
                else:
                    return None
        elif ch == 9:  # Tab
            state["scope"] = "all" if scope == "here" else "here"
            state["rows"], state["crashed"] = _gather_boxes(
                cwd=os.getcwd() if state["scope"] == "here" else None)
            cursor = 0
        elif ch in (curses.KEY_ENTER, 10, 13):
            return matches[cursor] if matches else None
        elif ch in (curses.KEY_BACKSPACE, 127, 8):
            filt = filt[:-1]
        elif 32 <= ch < 127:
            filt += chr(ch)
            cursor = 0


def cmd_picker():
    """Full-screen box selection when we own a real terminal; the numbered
    prompt flow otherwise (pipes, dumb terminals, scripts)."""
    if not (sys.stdout.isatty() and sys.stdin.isatty()):
        return cmd_rescue()
    here = os.getcwd()
    rows, crashed_sids = _gather_boxes(cwd=here)
    scope = "here"
    if not rows:
        rows, crashed_sids = _gather_boxes()
        scope = "all"
        if not rows:
            print("blackbox: no resumable sessions found anywhere.")
            return
    state = {"rows": rows, "crashed": crashed_sids, "cache": {}, "scope": scope}
    import curses
    sel = curses.wrapper(_picker_ui, state)
    if sel is None:
        return
    mt, root, tp, sid = sel[0], sel[1], sel[2], sel[3]
    crashed = {m["session_id"]: m for m in crashed_sessions()}
    m = crashed.get(sid) or _session_record(root, tp, sid)
    if m.get("unrecoverable"):
        print("blackbox: that session never saved a conversation — nothing to resume."
              + (f" Try: blackbox salvage {sid}" if m.get("salvageable") else ""))
        return
    if m.get("maybe_live"):
        try:
            sure = input("blackbox> evidence says this session may still be RUNNING. "
                         "Resume anyway? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return
        if sure != "y":
            return
    _exec_resume(m)


def _print_picker(sessions, heading):
    now = time.time()
    print(heading)
    for i, m in enumerate(sessions, 1):
        proj = m.get("cwd", "?").replace(HOME, "~")
        flags = []
        if m.get("unrecoverable"):
            flags.append("✗ never saved")
        if m.get("maybe_live"):
            flags.append("⚠ may be running")
        flag = ("  [" + ", ".join(flags) + "]") if flags else ""
        print(f"[{i}] {_fmt_age(m.get('age', now)):>10}  {m.get('ended', '?'):14} "
              f"{proj}{flag}")
        gist = m.get("last_user") or m.get("last_assistant") or ""
        if gist:
            print(f"      {gist[:100]}")


def cmd_rescue(target=None):
    if target:
        matches, truncated = _find_session_anywhere(target)
        if not matches:
            print(f"blackbox: no session matching {target!r} in markers or any "
                  "storage root. `blackbox scan --cwd <project>` lists what exists.")
            return
        if len(matches) > 1:
            print(f"blackbox: {target!r} is ambiguous — "
                  f"{len(matches)}{'+' if truncated else ''} sessions match:")
            for m in matches[:7]:
                proj = m.get("cwd", "?").replace(HOME, "~")
                print(f"  {m['session_id']}  {proj}"
                      + ("  [RUNNING]" if m.get("alive") else ""))
            print("Give more of the id.")
            return
        m = matches[0]
        if m.get("alive"):
            print(f"blackbox: session {m['session_id'][:8]} is RUNNING right now — "
                  "nothing to rescue. Find its window, or wait for it to exit.")
            return
        if m.get("unrecoverable"):
            print("blackbox: that session never saved a conversation — nothing to resume."
                  + (f" Try: blackbox salvage {m['session_id']}"
                     if m.get("salvageable") else ""))
            return
    else:
        # The flight-recorder picker: this project's last sessions first, the
        # whole machine on request. No expiry — a rolling last-N, aged.
        here = os.getcwd()
        sessions = _recent_sessions(cwd=here)
        showing_all = False
        if sessions:
            _print_picker(sessions,
                          f"Recent sessions in {here.replace(HOME, '~')}:")
        else:
            sessions = _recent_sessions(limit=10)
            showing_all = True
            if not sessions:
                print("blackbox: no resumable sessions found anywhere.")
                return
            _print_picker(sessions, "No sessions for this directory. "
                          "Recent sessions everywhere:")
        while True:
            prompt = ("\nblackbox> resume which? [number"
                      + ("" if showing_all else ", a = all projects")
                      + ", enter = quit] ")
            try:
                pick = input(prompt).strip().lower()
            except (EOFError, KeyboardInterrupt):
                return
            if pick == "a" and not showing_all:
                sessions = _recent_sessions(limit=10)
                showing_all = True
                _print_picker(sessions, "Recent sessions everywhere:")
                continue
            if not pick.isdigit() or not (1 <= int(pick) <= len(sessions)):
                return
            m = sessions[int(pick) - 1]
            break
        if m.get("unrecoverable"):
            print("blackbox: that session never saved a conversation — nothing to resume."
                  + (f" Try: blackbox salvage {m['session_id']}"
                     if m.get("salvageable") else ""))
            return
    if m.get("maybe_live"):
        try:
            sure = input("blackbox> evidence says this session may still be RUNNING "
                         "(fresh writes or an unaccounted live claude in its directory). "
                         "Resume anyway? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return
        if sure != "y":
            return
    _exec_resume(m)
    return



def _project_slug(cwd):
    """The directory name Claude Code stores a cwd's transcripts under:
    every non-alphanumeric character becomes '-'."""
    import re
    return re.sub(r"[^A-Za-z0-9-]", "-", cwd)


def cmd_scan(filter_cwd=None):
    """Registry-free sweep: newest transcripts in every storage root ever seen.

    For sessions that predate blackbox (no marker), this is how you find what
    exists at all — including per-profile roots that `claude --resume` alone
    would never look in from a default shell. With --cwd, only that project's
    sessions are shown (all of them, not the newest-12 cap) — the /rescue
    skill uses this to hunt for the current project's session and nothing
    else.
    """
    now = time.time()
    scanned = {}
    want = _project_slug(os.path.abspath(filter_cwd)) if filter_cwd else None
    total_shown = 0
    for root in _all_roots():
        pdir = os.path.join(root, "projects")
        if not os.path.isdir(pdir):
            continue
        rows = []
        for proj in os.listdir(pdir):
            if want and proj != want:
                continue
            full = os.path.join(pdir, proj)
            if not os.path.isdir(full):
                continue
            for f in os.listdir(full):
                if f.endswith(".jsonl"):
                    p = os.path.join(full, f)
                    try:
                        st = os.stat(p)
                    except OSError:
                        continue
                    if st.st_size > 50_000:
                        rows.append((st.st_mtime, st.st_size, proj, f[:-6], p))
        rows.sort(reverse=True)
        label = root.replace(HOME, "~")
        scanned[label] = len(rows)
        if want and not rows:
            continue  # keep --cwd output free of empty-root noise
        total_shown += len(rows)
        print(f"\n=== {label} — {len(rows)} substantive session(s) ===")
        for mt, sz, proj, sid, p in rows if want else rows[:12]:
            kind = _classify(p)
            print(f"  {_fmt_age(now - mt):>12}  {sz / 1e6:5.1f} MB  {proj}")
            if kind != "ok":
                print(f"                ✗ no conversation saved — try: blackbox salvage {sid}")
                continue
            u, _ = _preview(p, tail_bytes=300_000)
            if u:
                print(f"                you : {u[:120]}")
            print(f"                resume: CLAUDE_CONFIG_DIR={shlex.quote(root)} "
                  f"claude --resume {shlex.quote(sid)}")
    if want and total_shown == 0:
        print(f"blackbox: no saved sessions found for {filter_cwd} in any known root.")
    _log("scan", roots=scanned, cwd=filter_cwd or "")


def _version():
    """This binary's plugin version, from the manifest beside it. Several
    copies of blackbox can coexist (clone, per-root plugin caches, old cache
    versions) and an hour was once lost to not knowing which one was
    answering — so doctor states it up front."""
    try:
        root = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[0])))
        return json.load(open(os.path.join(
            root, ".claude-plugin", "plugin.json"))).get("version", "?")
    except Exception:
        return "?"


def cmd_doctor(as_json=False):
    """Is the recorder actually recording? Reads the log AND the world, because
    the one failure the log cannot contain is hooks not firing at all — that
    only shows up as transcripts changing with no matching log entries."""
    now = time.time()
    day_ago = now - 86400
    log = _log_tail()
    recent = [e for e in log if e.get("ts", 0) >= day_ago]

    counts = {}
    for e in recent:
        counts[e["event"]] = counts.get(e["event"], 0) + 1
    errors = [e for e in recent if e.get("ok") is False]
    slow = [e for e in recent if e.get("ms", 0) > 2000]

    # Coverage: transcripts that changed in the last 24h whose session id never
    # appears in the log = sessions blackbox did not see. THE reliability number.
    seen = {e.get("sid") for e in log if e.get("sid")}
    missed = []
    covered = 0
    for root in _all_roots():
        pdir = os.path.join(root, "projects")
        if not os.path.isdir(pdir):
            continue
        for proj in os.listdir(pdir):
            full = os.path.join(pdir, proj)
            if not os.path.isdir(full):
                continue
            for f in os.listdir(full):
                if not f.endswith(".jsonl"):
                    continue
                try:
                    st = os.stat(os.path.join(full, f))
                except OSError:
                    continue
                if st.st_mtime < day_ago or st.st_size < 10_000:
                    continue
                if f[:8] in seen:
                    covered += 1
                else:
                    missed.append({
                        "root": root.replace(HOME, "~"),
                        "project": proj,
                        "session": f[:-6],
                        "last_write": _fmt_age(now - st.st_mtime),
                    })

    live = crashed = hazards = 0
    if os.path.isdir(LIVE):
        for f in os.listdir(LIVE):
            if not f.endswith(".json"):
                continue
            try:
                mark = json.load(open(os.path.join(LIVE, f)))
            except Exception:
                continue
            if _alive(mark.get("pid"), mark.get("started_at")):
                live += 1
                if mark.get("hazard"):
                    hazards += 1
            else:
                crashed += 1

    # A root is protected only by what ITS OWN settings.json says: manual
    # hook commands, or an enabledPlugins entry. Nothing else counts — the
    # plugin installation registry and cache are SHARED across roots, and
    # checking them once reported a root as wired while its sessions ran
    # completely unhooked for five hours (a plugin installed from a session
    # under root A records enablement in A's settings, not the root the user
    # believed they were installing for).
    unwired = []
    doubled = []
    for root in _all_roots():
        manual, plugin = _root_wiring(root)
        if not (manual or plugin):
            unwired.append(root.replace(HOME, "~"))
        elif manual and plugin:
            doubled.append(root.replace(HOME, "~"))

    report = {
        "unwired_roots": unwired,
        "double_wired_roots": doubled,
        "hooks_fired_24h": counts,
        "hook_errors_24h": len(errors),
        "last_error": (errors[-1] if errors else None),
        "slow_hooks_over_2s": len(slow),
        "sessions": {"live": live, "crashed_unrescued": crashed, "live_at_risk": hazards},
        "coverage_24h": {"recorded": covered, "missed": len(missed), "missed_detail": missed[:10]},
        "log": {"path": LOG, "lines": len(log)},
        "blackbox": {"version": _version(),
                     "bin": os.path.realpath(sys.argv[0])},
    }
    if as_json:
        print(json.dumps(report, indent=2))
        return

    print(f"── blackbox doctor ── v{_version()} "
          f"({os.path.realpath(sys.argv[0]).replace(HOME, '~')})")
    if unwired:
        print(f"  ✗ UNWIRED ROOT(S) — sessions there are completely unprotected:")
        for r in unwired:
            print(f"      {r}")
            # The explicit form: installing from "a session under that root"
            # already burned one user — the pane wasn't under the root they
            # thought, enablement landed elsewhere, and doctor said fine.
            print(f"        fix: CLAUDE_CONFIG_DIR={r} claude plugin install "
                  f"blackbox@rdyplayerB")
            print(f"        (or, from a clone: ./install.sh {r})")
    else:
        print("  ✓ every known root has hooks wired")
    for r in doubled:
        print(f"  ✗ DOUBLE-WIRED: {r} has BOTH manual hooks and the plugin —")
        print(f"    every hook fires twice there. Fix: ./uninstall.sh {r}")
        print(f"    (removes the manual hooks; the plugin install stays)")
    hooks_24h = sum(v for k, v in counts.items() if k.startswith("hook."))
    print(f"  hooks fired (24h): {hooks_24h}  {dict(sorted(counts.items()))}")
    if errors:
        last = errors[-1]
        print(f"  ✗ {len(errors)} failed operation(s) — most recent: "
              f"{last.get('event', '?')}"
              + (f" sid={last['sid']}" if last.get("sid") else ""))
        if last.get("err"):
            print("    " + str(last["err"])[:300].replace("\n", "\n    "))
    else:
        print("  ✓ no failed operations in 24h")
    if slow:
        print(f"  ! {len(slow)} hook run(s) over 2s — a slow hook delays every session")
    print(f"  sessions now: {live} live ({hazards} NOT SAVING), {crashed} crashed awaiting rescue")
    cov = report["coverage_24h"]
    if cov["missed"]:
        print(f"  ✗ coverage: {cov['missed']} session(s) active in 24h that blackbox never saw:")
        for m in cov["missed_detail"]:
            print(f"      {m['project']}  ({m['root']}, last write {m['last_write']})")
        print("    Causes: session predates install, hooks not wired for that")
        print("    CLAUDE_CONFIG_DIR, or hooks failing before their first log line.")
    else:
        print(f"  ✓ coverage: all {cov['recorded']} active session(s) in 24h were recorded")
    print(f"  log: {LOG} ({len(log)} lines)")


def _drop_bin_path():
    """Record where this binary lives, so the /rescue skill and the plugin's
    hook commands can find it regardless of install method (plugin cache,
    manual clone, moved directory) — the path is refreshed on every run."""
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "bin-path"), "w") as f:
            f.write(os.path.realpath(os.path.abspath(sys.argv[0])))
        # Opportunistic PATH shim: if ~/.local/bin exists, keep a symlink
        # there so recovery is typed as `blackbox rescue <id>` instead of a
        # full path — profile gymnastics are this tool's job, not the user's.
        lb = os.path.join(HOME, ".local", "bin")
        if os.path.isdir(lb):
            link = os.path.join(lb, "blackbox")
            target = os.path.realpath(os.path.abspath(sys.argv[0]))
            try:
                if os.path.islink(link):
                    if os.path.realpath(link) != target:
                        os.unlink(link)
                        os.symlink(target, link)
                elif not os.path.exists(link):
                    os.symlink(target, link)
            except OSError:
                pass
    except Exception:
        pass


def main():
    _drop_bin_path()
    args = sys.argv[1:]
    if not args:
        cmd_picker()
        return
    cmd = args[0]
    if cmd == "hook":
        # Hooks must NEVER break a session: any failure is swallowed — but
        # logged first, or a broken recorder is indistinguishable from a
        # working one until a rescue comes up empty.
        t0 = time.time()
        sub = args[1] if len(args) > 1 else "?"
        try:
            extra = {"start": hook_start, "stop": hook_stop, "end": hook_end}[sub]()
            _log("hook." + sub, ok=True, ms=round((time.time() - t0) * 1000, 1),
                 **(extra if isinstance(extra, dict) else {}))
        except Exception:
            import traceback
            _log("hook." + sub, ok=False, ms=round((time.time() - t0) * 1000, 1),
                 err=traceback.format_exc()[-1500:])
    elif cmd == "list":
        cmd_list(as_json="--json" in args, show_all="--all" in args)
    elif cmd == "rescue":
        if len(args) > 1:
            cmd_rescue(target=args[1])
        else:
            cmd_picker()
    elif cmd == "scan":
        fc = None
        if "--cwd" in args:
            i = args.index("--cwd")
            fc = args[i + 1] if len(args) > i + 1 else os.getcwd()
        cmd_scan(filter_cwd=fc)
    elif cmd == "salvage" and len(args) > 1:
        cmd_salvage(args[1])
    elif cmd == "doctor":
        cmd_doctor(as_json="--json" in args)
    elif cmd == "root" and len(args) > 1:
        # Register a storage root by hand — for sessions that predate blackbox
        # (hooks register roots automatically from then on).
        r = os.path.abspath(os.path.expanduser(args[1]))
        if os.path.isdir(os.path.join(r, "projects")):
            _remember_root(r)
            print(f"registered root: {r}")
        else:
            print(f"blackbox: {r} has no projects/ directory")
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
